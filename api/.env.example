NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/pawrescue?retryWrites=true&w=majority
# Comma-separated list of allowed origins
CLIENT_ORIGIN=http://localhost:3000

# Auth
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d
# Google OAuth Web client ID (same value as web NEXT_PUBLIC_GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=

# First admin account (created on startup if no admin exists)
ADMIN_NAME=PawRescue Admin
ADMIN_EMAIL=admin@pawrescue.dev
ADMIN_PASSWORD=change-me

# Photo storage (leave empty to store photos locally in api/uploads during development)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Max distance (km) searched when matching NGOs to a new report
NGO_MATCH_MAX_KM=50

# AI service (ml/). If it is offline the API falls back to keyword triage.
ML_URL=http://127.0.0.1:8000
ML_TIMEOUT_MS=8000

# Email (password reset codes) via Brevo free tier. Empty = codes printed in the API console
BREVO_API_KEY=
MAIL_FROM=
