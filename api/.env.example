NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/pawrescue?retryWrites=true&w=majority
# Comma-separated list of allowed origins
CLIENT_ORIGIN=http://localhost:3000

# Auth
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d
# Google OAuth Web client ID (same value as web NEXT_PUBLIC_GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=

# First admin account (created on startup if no admin exists)
ADMIN_NAME=PawRescue Admin
ADMIN_EMAIL=admin@pawrescue.dev
ADMIN_PASSWORD=change-me
